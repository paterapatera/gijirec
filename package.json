{
  "name": "gijirec",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "biome check --write .",
    "format-check": "biome check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "bun test src/presentation src/application src/domain src/infrastructure",
    "test:arch": "bun test scripts/verify-depcruise-layers.test.ts",
    "knip": "knip",
    "check": "bun run format-check && bun run typecheck && bun run lint && bun run arch && bun run knip",
    "verify": "bun run check && bun run test && bun run test:arch && bun run rust:check && bun run rust:test",
    "rust:format": "cargo fmt --all --manifest-path src-tauri/Cargo.toml",
    "rust:format-check": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:typecheck": "bun scripts/cargo-src-tauri.mjs check --workspace --all-targets --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "bun scripts/cargo-src-tauri.mjs clippy --workspace --all-targets --manifest-path src-tauri/Cargo.toml -- -D clippy::all",
    "rust:arch": "cargo bylaw check --config src-tauri/bylaw.toml --manifest-path src-tauri/Cargo.toml -p gijirec-domain -p gijirec-application -p gijirec-infrastructure -p gijirec-presentation",
    "rust:dead-code": "cargo machete src-tauri",
    "rust:test": "bun scripts/cargo-src-tauri.mjs test --workspace --manifest-path src-tauri/Cargo.toml",
    "rust:test:release": "bun scripts/cargo-src-tauri.mjs test --workspace --release --manifest-path src-tauri/Cargo.toml",
    "rust:check": "bun run rust:format-check && bun run rust:typecheck && bun run rust:lint && bun run rust:arch && bun run rust:dead-code"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.14.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "happy-dom": "^20.14.0",
    "knip": "^6.34.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "slate": "^0.126.2",
    "slate-react": "^0.126.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  }
}
