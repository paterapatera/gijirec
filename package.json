{
  "name": "gijirec",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "format": "biome check --write .",
    "format-check": "biome check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
