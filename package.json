{
  "name": "gijirec",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "biome check --write .",
    "format-check": "biome check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:arch": "bun test scripts/verify-depcruise-layers.test.ts",
    "knip": "knip",
    "check": "bun run format-check && bun run typecheck && bun run lint && bun run arch && bun run test:arch && bun run knip",
    "rust:format": "cargo fmt --all --manifest-path src-tauri/Cargo.toml",
    "rust:format-check": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:typecheck": "cargo check --workspace --all-targets --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --workspace --all-targets --manifest-path src-tauri/Cargo.toml -- -D clippy::all",
    "rust:arch": "cargo bylaw check --config src-tauri/bylaw.toml --manifest-path src-tauri/Cargo.toml -p gijirec-domain -p gijirec-application -p gijirec-infrastructure -p gijirec-presentation",
    "rust:dead-code": "cargo machete src-tauri",
    "rust:check": "bun run rust:format-check && bun run rust:typecheck && bun run rust:lint && bun run rust:arch && bun run rust:dead-code"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.14.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "happy-dom": "^20.14.0",
    "knip": "^6.34.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
