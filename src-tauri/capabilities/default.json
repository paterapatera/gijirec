{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-capture-phase",
    "allow-get-transcribe-phase",
    "allow-listen-capture-events",
    "allow-listen-transcribe-events",
    "allow-editor-commands",
    "allow-audio-device-commands",
    "allow-listen-audio-device-events",
    "fs:default",
    "dialog:default"
  ]
}
